[
  {
    "aggregate": "component_def_instance_counts",
    "pipeline": [
      {
        "$project": {
          "_id": 0,
          "tenantID": "$tenantID",
          "name": "$defName",
          "version": "$version",
          "appCompInstanceCount": "$appCompInstanceCount",
          "workspaceCompInstanceCount": "$workspaceCompInstanceCount"
        }
      },
      {
        "$merge": {
          "into": "component_defs",
          "on": ["tenantID", "name", "version"],
          "whenMatched": "merge",
          "whenNotMatched": "discard"
        }
      }
    ],
    "cursor": {}
  },
  {
    "drop": "component_def_instance_counts"
  },
  {
    "createIndexes": "component_defs",
    "indexes": [
      {
        "key": {
          "name": 1,
          "version": 1
        },
        "name": "name_1_version_1",
        "unique": true
      }
    ]
  },
  {
    "dropIndexes": "component_defs",
    "index": "tenantID_1_name_1_version_1"
  },
  {
    "update": "component_defs",
    "updates": [
      {
        "q": { "tenantID": "default" },
        "u": { "$unset": { "tenantID": "" } },
        "multi": true
      }
    ]
  }
]
