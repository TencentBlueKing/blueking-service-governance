meta {
  name: 01-get-runtime-definitions
  type: http
  seq: 1
}

get {
  url: {{serviceURL}}/app-runtime-definitions
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should return the framework catalog", () => {
    const frameworks = res.body.data.frameworks;
    const byName = Object.fromEntries(frameworks.map((f) => [f.name, f]));
    expect(byName.trpc.supportedLanguages).to.have.members(["go", "cpp", "python"]);
    expect(byName.taf.supportedLanguages).to.deep.equal(["cpp"]);
    expect(byName.blank.supportedLanguages).to.have.members(["go", "cpp", "nodejs", "python"]);
  });

  test("should return the capability matrix for every valid stack", () => {
    const matrix = res.body.data.matrix;
    expect(matrix).to.have.lengthOf(8);
    // blank 只有基座的配置文件合并，以及只看语言的平台构建（go / python）
    const platformBuildLanguages = ["go", "python"];
    ["go", "cpp", "nodejs", "python"].forEach((language) => {
      const blank = matrix.find((v) => v.framework === "blank" && v.language === language);
      expect(blank, `blank+${language}`).to.be.an("object");
      Object.entries(blank.mods).forEach(([id, mod]) => {
        const expected = id === "configFileMerge" || (id === "platformBuild" && platformBuildLanguages.includes(language));
        expect(mod.supported, `blank+${language} ${id}`).to.equal(expected);
      });
    });
    ["go", "python"].forEach((language) => {
      const trpc = matrix.find((v) => v.framework === "trpc" && v.language === language);
      expect(trpc.mods.platformBuild.supported, `trpc+${language}`).to.equal(true);
    });
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
