meta {
  name: 07-update-blank-startup-config
  type: http
  seq: 7
}

put {
  url: {{serviceURL}}/apps/{{bkmsAppBlankID}}/startup-config
  body: json
  auth: inherit
}

body:json {
  {
    "shCommand": "sleep 7200",
    "frameworkConfig": {}
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

script:post-response {
  const axios = require("axios");
  const {authHeaders} = require("./common");
  const resp = await axios.get(`${bru.getEnvVar("serviceURL")}/apps/${bru.getVar("bkmsAppBlankID")}`,
    {headers: authHeaders()});
  bru.setVar("bkmsAppBlankSpecJSON", JSON.stringify(resp.data.data.appModelSpec));
}

tests {
  test("should replace the start config", () => {
    const spec = JSON.parse(bru.getVar("bkmsAppBlankSpecJSON"));
    expect(spec.shCommand).to.equal("sleep 7200");
    expect(spec.command).to.deep.equal([]);
    expect(spec.args).to.deep.equal([]);
    expect(spec.envVars.map((v) => v.key)).to.deep.equal(["BLANK_VAR"]);
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
