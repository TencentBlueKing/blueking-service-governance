meta {
  name: get-topology-node-manifest-no-snapshot
  type: http
  seq: 4
}

get {
  url: {{serviceURL}}/apps/{{topologyAppID}}/envs/{{topologyEnvName}}/resource-topology/nodes/{{topologyNodeID}}/manifest
  body: none
  auth: inherit
}

assert {
  res.status: eq 500
  res.body: isJson
}

tests {
  test("should return internal error when no resource snapshot exists for node manifest", () => {
    expect(res.body.error.code).to.equal("INTERNAL_SERVER_ERROR");
    expect(res.body.error.system).to.equal("bkms");
    expect(res.body.error.module).to.equal("bkms-server");
    expect(res.body.error.message).to.be.a("string").that.is.not.empty;
    expect(res.body.error.message).to.not.contain("resolve node");
    expect(res.body.error.details[0].code).to.equal("INTERNAL_SERVER_ERROR");
    expect(res.body.error.details[0].message).to.contain("get node manifest: resolve node");
    expect(res.body.error.details[0].message).to.contain("no resource snapshot found");
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
