meta {
  name: create-build-should-fail-when-commit-invalid
  type: http
  seq: 4
}

post {
  url: {{serviceURL}}/apps/{{testBuildTrpcAppID}}/builds
  body: json
  auth: inherit
}

body:json {
  {
    "revisionType": "commit",
    "revision": "a1b2c3",
    "imageTag": "v1.0.2"
  }
}

assert {
  res.status: eq 400
  res.body: isJson
}

tests {
  test("should reject commit id shorter than 7 characters", () => {
    expect(res.body.error.message).to.contains("commit id must be 7-40 hexadecimal characters");
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
