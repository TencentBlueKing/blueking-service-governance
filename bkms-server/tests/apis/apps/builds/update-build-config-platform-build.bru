meta {
  name: update-build-config-platform-build
  type: http
  seq: 4
}

put {
  url: {{serviceURL}}/apps/{{testBuildTrpcAppID}}/build-configs
  body: json
  auth: inherit
}

body:json {
  {
    "sourceType": "codeRepository",
    "codeRepo": {
      "type": "TGit",
      "defaultBranch": "main",
      "repoAlias": "test-repo",
      "repoURL": "https://git.com/bkms-govern.git",
      "sourceDir": ".",
      "imageBuildMode": "platform",
      "platformBuildConfig": {
        "builderImage": "golang:1.24",
        "runnerImage": "debian:12",
        "commands": {
          "preBuild": [
            "go mod download"
          ],
          "build": [
            "go build -o app ./cmd/server"
          ],
          "runtimeEnv": [
            "apt-get update && apt-get install -y ca-certificates"
          ],
          "start": "./app"
        },
        "extraFiles": [
          "data/key.pem",
          "certs",
          "data/*.pem"
        ]
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should update build config with platform build successfully", () => {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an('object');
  });

  test("should return platform build config", () => {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an('object');

    const codeRepo = res.body.data.codeRepo;
    expect(codeRepo).to.be.an('object');
    expect(codeRepo.imageBuildMode).to.equal('platform');
    expect(codeRepo.platformBuildConfig).to.be.an('object');
    expect(codeRepo.platformBuildConfig.builderImage).to.equal('golang:1.24');
    expect(codeRepo.platformBuildConfig.runnerImage).to.equal('debian:12');
    expect(codeRepo.platformBuildConfig.commands.start).to.equal('./app');
    expect(codeRepo.platformBuildConfig.commands.preBuild).to.deep.equal(['go mod download']);
    expect(codeRepo.platformBuildConfig.commands.build).to.deep.equal(['go build -o app ./cmd/server']);
    expect(codeRepo.platformBuildConfig.commands.runtimeEnv).to.deep.equal([
      'apt-get update && apt-get install -y ca-certificates'
    ]);
    expect(codeRepo.platformBuildConfig.extraFiles).to.deep.equal([
      'data/key.pem',
      'certs',
      'data/*.pem'
    ]);
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
