meta {
  name: audit-records
  type: http
  seq: 16
}

get {
  url: {{serviceURL}}/workspaces/{{lifecycleWorkspaceID}}/operation-records?page=1&pageSize=100&appID={{lifecycleAppID}}&resourceType=app&username=api-test-user
  body: none
  auth: inherit
}

script:pre-request {
  const {waitForOperationRecords} = require("./helpers/audit");
  await waitForOperationRecords(req);
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  const records = res.body?.data?.results ?? [];

  test("should contain default lifecycle update audit record", () => {
    const candidates = records.filter((item) =>
      item.operationType === "update" &&
      item.attribute === "appModel" &&
      !item.group.envName
    );

    const record = candidates.find((item) => {
      const after = item.data?.after ? JSON.parse(item.data.after) : null;
      return after && (after.PostStart || after.PreStop || after.TerminationGracePeriodSeconds !== undefined);
    });

    expect(record, `matched records: ${JSON.stringify(candidates, null, 2)}`).to.exist;
  });

  test("should contain env lifecycle update audit record", () => {
    const candidates = records.filter((item) =>
      item.operationType === "update" &&
      item.attribute === "appModel" &&
      item.group.envName === bru.getVar("testEnv")
    );

    const record = candidates.find((item) => {
      const after = item.data?.after ? JSON.parse(item.data.after) : null;
      return after && after.PostStart &&
        Array.isArray(after.PostStart.Command) &&
        after.PostStart.Command.includes("echo env-started");
    });

    expect(record, `matched records: ${JSON.stringify(candidates, null, 2)}`).to.exist;
  });

  test("should contain env lifecycle delete audit record", () => {
    const candidates = records.filter((item) =>
      item.operationType === "delete" &&
      item.attribute === "appModel" &&
      item.group.envName === bru.getVar("testEnv")
    );

    const record = candidates.find((item) => {
      const before = item.data?.before ? JSON.parse(item.data.before) : null;
      return before && !item.data?.after;
    });

    expect(record, `matched records: ${JSON.stringify(candidates, null, 2)}`).to.exist;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
