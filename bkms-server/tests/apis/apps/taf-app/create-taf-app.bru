meta {
  name: create-taf-app
  type: http
  seq: 1
}

post {
  url: {{serviceURL}}/workspaces/{{workspaceID}}/apps
  body: json
  auth: inherit
}

body:json {
  {
    "name": "app-taf-test-{{randomSuffix}}",
    "id": "app-taf-test-{{randomSuffix}}-id",
    "type": "taf",
    "displayName": "TAF App Test",
    "appModelSpec": {
      "tafSpec": {
        "fileName": "taf_config.conf",
        "filePath": "/usr/local/taf/conf/",
        "fileContent": "dGVzdAo="
      },
      "envVars": [
        {
          "key": "PRESERVED_TAF_VAR",
          "value": "taf-value",
          "description": "preserved across spec updates"
        }
      ]
    },
    "buildConfig": {
      "sourceType": "codeRepository",
      "repoBuildConfig": {
        "type": "TGit",
        "repoAlias": "test",
        "repoURL": "https://git.com/bkms-govern.git",
        "defaultBranch": "main",
        "sourceDir": ".",
        "dockerfile": "Dockerfile",
        "dockerBuildArgs": {
          "ARG1": "value1",
          "ARG2": "value2"
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

script:post-response {
  // Save taf app name and ID for later tests
  if (res.body && res.body.data) {
    if (res.body.data.name) {
      bru.setVar('testTafAppName', res.body.data.name);
      console.log("Saved testTafAppName:", res.body.data.name);
    }
    if (res.body.data.id) {
      bru.setVar('testTafAppID', res.body.data.id);
      console.log("Saved testTafAppID:", res.body.data.id);
    }
  }
}

tests {
  test("should create taf app successfully", () => {
    // 旧创建接口按 bkmsApp 创建，响应的 type 为 bkmsApp
    expect(res.body.data.type).to.equal('bkmsApp');
    expect(res.body.data.name).to.contain(bru.getVar('randomSuffix'));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
