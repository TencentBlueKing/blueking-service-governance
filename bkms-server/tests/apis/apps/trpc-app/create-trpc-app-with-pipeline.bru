meta {
  name: create-trpc-app-with-pipeline
  type: http
  seq: 5
}

post {
  url: {{serviceURL}}/workspaces/{{workspaceID}}/apps
  body: json
  auth: inherit
}

body:json {
  {
    "name": "app-trpc-pipeline-{{randomSuffix}}",
    "id": "app-trpc-pipeline-{{randomSuffix}}-id",
    "type": "trpc",
    "displayName": "TRPC App with Pipeline",
    "appModelSpec": {
      "trpcSpec": {
        "language": "go",
        "fileName": "trpc_go.yaml",
        "filePath": "/usr/local/trpc/bin/",
        "fileContent": "dGVzdAo="
      }
    },
    "buildConfig": {
      "sourceType": "pipeline",
      "pipelineType": "pipeline",
      "pipelineBuildConfig": {
        "pipelineID": "p-test-pipeline-123",
        "params": {
          "BRANCH": "main",
          "REPO_URL": "https://git.com/bkms-govern-pipeline.git"
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

script:post-response {
  bru.setVar('testTrpcPipelineAppName', res.body.data.name);
  bru.setVar('testTrpcPipelineAppID', res.body.data.id);
}

tests {
  test("should create trpc app with pipeline successfully", () => {
    // 旧创建接口按 bkmsApp 创建，响应的 type 为 bkmsApp
    expect(res.body.data.type).to.equal('bkmsApp');
    expect(res.body.data.name).to.contain(bru.getVar('randomSuffix'));
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
