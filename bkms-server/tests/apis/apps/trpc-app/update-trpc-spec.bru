meta {
  name: update-trpc-spec
  type: http
  seq: 2
}

put {
  url: {{serviceURL}}/apps/{{testTrpcAppID}}/trpc-spec
  body: json
  auth: inherit
}

body:json {
  {
    "appModelSpec": {
      "envVars": [
        {
          "key": "IGNORED_TRPC_VAR",
          "value": "should-not-be-stored"
        }
      ],
      "trpcSpec": {
        "language": "go",
        "fileName": "trpc_go.yaml",
        "filePath": "/usr/local/trpc/updated/"
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should update appmodel spec successfully", () => {
    expect(res.status).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
