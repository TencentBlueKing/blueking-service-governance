meta {
  name: verify-build-codeRepo
  type: http
  seq: 9
}

get {
  url: {{serviceURL}}/apps/{{testTrpcPipelineAppID}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
  res.body.data.buildConfig.repoBuildConfig: isJson
}

tests {
  console.log(res.body)
  console.log(res.body.data.buildConfig)
  test("should verify appmodel spec was updated", () => {
    expect(res.body.data.appModelSpec.trpcSpec.fileName).to.equal('trpc_go.yaml');
    expect(res.body.data.appModelSpec.trpcSpec.filePath).to.equal('/usr/local/trpc/bin');
    expect(res.body.data.buildConfig.repoBuildConfig.type).to.equal("TGit")
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
