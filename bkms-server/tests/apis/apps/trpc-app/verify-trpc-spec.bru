meta {
  name: verify-trpc-spec
  type: http
  seq: 3
}

get {
  url: {{serviceURL}}/apps/{{testTrpcAppID}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should verify appmodel spec was updated", () => {
    expect(res.body.data.appModelSpec.trpcSpec.fileName).to.equal('trpc_go.yaml');
    expect(res.body.data.appModelSpec.trpcSpec.filePath).to.equal('/usr/local/trpc/updated');
    const envVar = res.body.data.appModelSpec.envVars.find(({ key }) => key === "PRESERVED_TRPC_VAR");
    expect(envVar).to.not.be.undefined;
    expect(envVar).to.include({
      value: "trpc-value",
      description: "preserved across spec updates",
    });
  });

  test("should ignore env vars sent through trpc spec update", () => {
    const envVar = res.body.data.appModelSpec.envVars.find(({ key }) => key === "IGNORED_TRPC_VAR");
    expect(envVar).to.be.undefined;
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
