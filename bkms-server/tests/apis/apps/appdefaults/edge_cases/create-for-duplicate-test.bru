meta {
  name: create-duplicate-should-fail
  type: http
  seq: 1
}

post {
  url: {{serviceURL}}/workspaces/{{appDefaultsWorkspaceID}}/app-spec/resources
  body: json
  auth: inherit
}

body:json {
  {
    "envType": "development",
    "spec": {
      "replicas": 1,
      "cpuRequests": "500m",
      "cpuLimits": "1",
      "memoryRequests": "1Gi",
      "memoryLimits": "2Gi"
    }
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar('duplicateTestRuleID', res.body.data.id);
}

settings {
  encodeUrl: true
  timeout: 10000
}
