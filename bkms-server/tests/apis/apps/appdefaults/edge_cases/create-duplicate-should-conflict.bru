meta {
  name: create-duplicate-should-conflict
  type: http
  seq: 2
}

post {
  url: {{serviceURL}}/workspaces/{{appDefaultsWorkspaceID}}/app-spec/resources
  body: json
  auth: inherit
}

body:json {
  {
    "envType": "development",
    "spec": {
      "replicas": 2,
      "cpuRequests": "1",
      "cpuLimits": "2",
      "memoryRequests": "2Gi",
      "memoryLimits": "4Gi"
    }
  }
}

assert {
  res.status: eq 400
}

tests {
  test("should reject duplicate environment type rule", () => {
    expect(res.status).to.equal(400);
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
