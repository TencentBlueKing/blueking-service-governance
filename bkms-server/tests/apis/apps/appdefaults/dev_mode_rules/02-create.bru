meta {
  name: create-dev-mode-rule
  type: http
  seq: 2
}

post {
  url: {{serviceURL}}/workspaces/{{appDefaultsWorkspaceID}}/app-spec/dev-mode
  body: json
  auth: inherit
}

body:json {
  {
    "envType": "staging",
    "spec": {
      "enabled": true
    }
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should create a separate dev-mode rule for the same environment type", () => {
    const rule = res.body.data;
    expect(rule.id).to.be.a("string").and.not.be.empty;
    expect(rule.id).to.not.equal(bru.getVar("resourcesRuleID"));
    expect(rule.envType).to.equal("staging");
    expect(rule.spec).to.deep.equal({enabled: true});

    bru.setVar("devModeRuleID", rule.id);
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
