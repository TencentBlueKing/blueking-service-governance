meta {
  name: list-created-dev-mode-rule
  type: http
  seq: 3
}

get {
  url: {{serviceURL}}/workspaces/{{appDefaultsWorkspaceID}}/app-spec/dev-mode
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should list only the created dev-mode rule", () => {
    expect(res.body.data).to.have.lengthOf(1);
    expect(res.body.data[0].id).to.equal(bru.getVar("devModeRuleID"));
    expect(res.body.data[0].envType).to.equal("staging");
    expect(res.body.data[0].spec).to.deep.equal({enabled: true});
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
