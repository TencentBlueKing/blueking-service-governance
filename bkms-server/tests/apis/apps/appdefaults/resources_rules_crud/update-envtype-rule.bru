meta {
  name: update-envtype-rule
  type: http
  seq: 3
}

put {
  url: {{serviceURL}}/workspaces/{{appDefaultsWorkspaceID}}/app-spec/resources/{{envTypeResourcesRuleID}}
  body: json
  auth: inherit
}

body:json {
  {
    "envType": "production",
    "spec": {
      "replicas": 5,
      "cpuRequests": "4",
      "cpuLimits": "8",
      "memoryRequests": "8Gi",
      "memoryLimits": "16Gi"
    }
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should update the envType rule", () => {
    const rule = res.body.data;
    expect(rule.id).to.equal(bru.getVar('envTypeResourcesRuleID'));
    expect(rule.spec.replicas).to.equal(5);
    expect(rule.spec.cpuRequests).to.equal('4');
    expect(rule.spec.memoryLimits).to.equal('16Gi');
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
