meta {
  name: reject-invalid-environment-type
  type: http
  seq: 1
}

post {
  url: {{serviceURL}}/workspaces/{{appDefaultsWorkspaceID}}/app-spec/resources
  body: json
  auth: inherit
}

body:json {
  {
    "envType": "invalid-type",
    "spec": {
      "replicas": 1,
      "cpuRequests": "1",
      "cpuLimits": "2",
      "memoryRequests": "2Gi",
      "memoryLimits": "4Gi"
    }
  }
}

assert {
  res.status: eq 400
  res.body: isJson
}

tests {
  test("should reject an unsupported environment type", () => {
    expect(res.status).to.equal(400);
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
