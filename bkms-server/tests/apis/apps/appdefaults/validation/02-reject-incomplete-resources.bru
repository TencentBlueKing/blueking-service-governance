meta {
  name: reject-incomplete-resources-rule
  type: http
  seq: 2
}

post {
  url: {{serviceURL}}/workspaces/{{appDefaultsWorkspaceID}}/app-spec/resources
  body: json
  auth: inherit
}

body:json {
  {
    "envType": "production",
    "spec": {
      "replicas": 1,
      "cpuRequests": "1",
      "cpuLimits": "2",
      "memoryRequests": "2Gi"
    }
  }
}

assert {
  res.status: eq 400
  res.body: isJson
}

tests {
  test("should require every resources field", () => {
    expect(res.status).to.equal(400);
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
