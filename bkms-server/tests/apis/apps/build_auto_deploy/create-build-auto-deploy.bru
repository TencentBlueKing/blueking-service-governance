meta {
  name: create-build-auto-deploy
  type: http
  seq: 2
}

post {
  url: {{serviceURL}}/apps/{{testBuildDeployTrpcAppID}}/envs/{{testBuildDeployEnvName}}/trpc-build-deploys
  body: json
  auth: inherit
}

body:json {
  {
    "revisionType": "tag",
    "revision": "v1.0.0",
    "imageTag": "v1.0.0-build-deploy",
    "replicas": 2
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

script:post-response {
  if (res.body && res.body.data) {
    if (res.body.data.buildID) {
      bru.setVar("testBuildDeployBuildID", res.body.data.buildID);
      console.log("Created trpc-build-deploy build ID:", res.body.data.buildID);
    }
  }
}

tests {
  test("should create trpc-build-deploy successfully", () => {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an('object');
  });

  test("should return build-like response fields", () => {
    const buildData = res.body.data;
    expect(buildData.buildID).to.be.a('string');
    expect(buildData.pipelineID).to.be.a('string');
    expect(buildData.status).to.be.a('string');
    expect(buildData.params.BKMS_IMAGE_TAG).to.equal('v1.0.0-build-deploy');
  });

  test("should checkout by tag", () => {
    const buildData = res.body.data;
    expect(buildData.revisionType).to.equal('tag');
    expect(buildData.revision).to.equal('v1.0.0');
    expect(buildData.params.BKMS_REPO_CHECKOUT_BY).to.equal('TAG');
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
