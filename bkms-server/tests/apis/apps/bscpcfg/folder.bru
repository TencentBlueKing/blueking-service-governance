meta {
  name: bscpcfg
  seq: 5
}

auth {
  mode: inherit
}

script:pre-request {
  const common = require("./common")

  if (!bru.getVar("bscpCfgAppID")) {
    const suffix = bru.getVar("randomSuffix");
    const ws = await common.createWorkspace({id: `bscpcfg-ws-${suffix}`, bkCCBizID: 100})
    const app = await common.createHelmApp({id: `bscpcfg-app-${suffix}`, workspaceID: ws.id})
    const env = await common.createEnvironment({
      name: `dev`,
      workspaceID: ws.id,
      cluster: {clusterID: "BCS-K8S-12345", namespace: `default-${suffix}`}
    })

    bru.setVar("bscpCfgWorkspaceID", ws.id);
    bru.setVar("bscpCfgAppID", app.id);
    bru.setVar("bscpCfgAppName", app.name);
    bru.setVar("bscpCfgEnvName", env.name);
  }
}
