meta {
  name: 06-reject-unknown-env-name
  type: http
  seq: 6
}

put {
  url: {{serviceURL}}/apps/{{visEnvAppID}}/visible-envs
  body: json
  auth: inherit
}

body:json {
  {
    "visibleEnvNames": ["{{visEnvListedEnvName}}", "vis-no-such-env"]
  }
}

assert {
  res.status: eq 400
  res.body: isJson
}

tests {
  // AC-006：含未知 name 时整单拒绝，错误信息列出不合法的 name
  test("should reject the whole update when a name is not a workspace standard env", () => {
    expect(res.body.error).to.be.an("object");
    expect(res.body.error.code).to.equal("INVALID_REQUEST");
    expect(res.body.error.message).to.contain("vis-no-such-env");
    expect(res.body.error.system).to.equal("bkms");
    expect(res.body.error.module).to.equal("bkms-server");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
