meta {
  name: 14-clear-visible-envs
  type: http
  seq: 14
}

put {
  url: {{serviceURL}}/apps/{{visEnvAppID}}/visible-envs
  body: json
  auth: inherit
}

body:json {
  {
    "visibleEnvNames": []
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  // 空数组表示清空配置。成功响应不回显名单，清空后的行为由 15 号 precheck 确认
  test("should accept an empty list", () => {
    expect(res.status).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
