meta {
  name: 04-list-and-latest
  type: http
  seq: 4
}

get {
  url: {{serviceURL}}/apps/{{tafLifecycleAppID}}/envs/{{tafLifecycleEnvName}}/taf-deploys?page=1&pageSize=10
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

script:post-response {
  const axios = require("axios");
  const {AUTH_HEADERS} = require("./common");

  const serviceURL = bru.getEnvVar("serviceURL");
  const appID = bru.getVar("tafLifecycleAppID");
  const envName = bru.getVar("tafLifecycleEnvName");
  const resp = await axios.get(
    `${serviceURL}/apps/${appID}/envs/${envName}/taf-deploys/latest-status`,
    {headers: AUTH_HEADERS, params: {trafficLaneName: ""}}
  );
  bru.setVar("tafLifecycleLatestStatusJSON", JSON.stringify(resp.data?.data || null));
}

tests {
  test("should list taf-deploys with the v1 record on top", () => {
    expect(res.body.data).to.be.an("object");
    expect(res.body.data.results).to.be.an("array").and.not.empty;

    const latest = res.body.data.results[0];
    expect(latest.id).to.equal(bru.getVar("tafLifecycleFirstDeployID"));
    expect(latest.imageTag).to.equal(bru.getVar("tafLifecycleImageTag1"));
    expect(latest.status).to.equal("deployed");
    expect(latest.replicas).to.equal(1);
    expect(latest.clusterID).to.equal("BCS-K8S-00003");
    expect(latest.namespace).to.equal("default");
  });

  test("should expose the v1 record via latest-status", () => {
    const latest = JSON.parse(bru.getVar("tafLifecycleLatestStatusJSON"));
    expect(latest, "latest-status data").to.be.an("object").and.not.null;
    expect(latest.hasDeployRecord).to.equal(true);
    expect(latest.deployID).to.equal(bru.getVar("tafLifecycleFirstDeployID"));
    expect(latest.status).to.equal("deployed");
    expect(latest.isBuildAutoDeploy).to.equal(false);
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
