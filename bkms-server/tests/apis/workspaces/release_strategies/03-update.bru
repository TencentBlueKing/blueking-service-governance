meta {
  name: update-release-strategy
  type: http
  seq: 3
}

put {
  url: {{serviceURL}}/workspaces/{{releaseStrategyWorkspaceID}}/release-strategies/{{releaseStrategyID}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "生产谨慎发布",
    "batches": [
      {"target": "2", "pauseMode": "permanent"},
      {"target": "100%", "pauseMode": "none"}
    ]
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

settings {
  encodeUrl: true
  timeout: 10000
}
