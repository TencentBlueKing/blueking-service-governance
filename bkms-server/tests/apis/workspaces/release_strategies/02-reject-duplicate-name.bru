meta {
  name: reject-duplicate-release-strategy-name
  type: http
  seq: 2
}

post {
  url: {{serviceURL}}/workspaces/{{releaseStrategyWorkspaceID}}/release-strategies
  body: json
  auth: inherit
}

body:json {
  {
    "name": "生产谨慎发布",
    "batches": [
      {"target": "100%", "pauseMode": "none"}
    ]
  }
}

assert {
  res.status: eq 400
  res.body: isJson
}

tests {
  test("should reject a duplicated name", () => {
    expect(res.body.error.message).to.include("名称已存在");
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
