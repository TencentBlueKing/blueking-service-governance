meta {
  name: list-workspace-roles
  type: http
  seq: 1
}

script:pre-request {
  const common = require("./common")

  // Make sure the workspace exists.
  const suffix = bru.getVar("randomSuffix");
  await common.createWorkspace({id: `workspace-users-ws-${suffix}`})
}

get {
  url: {{serviceURL}}/workspaces/{{createdWorkspaceID}}/roles
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
  res.body.data.length: eq 4
  res.body.data[0].roleCode: eq admin
  res.body.data[0].builtin: eq true
  res.body.data[0].members: matches ["admin", "blueking"]
}

settings {
  encodeUrl: true
  timeout: 5000
  followRedirects: true
  maxRedirects: 5
}
