meta {
  name: set-workspace-state-disabled
  type: http
  seq: 9
}

patch {
  url: {{serviceURL}}/workspaces/{{imageRegistryWsID}}/state
  body: json
  auth: inherit
}

body:json {
  {
    "state": "Disabled",
    "linkedProjects": ["bkci"]
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should set workspace state to disabled", () => {
    expect(res.body.data.state).to.equal("Disabled");
  });

  test("should disable selected linked projects", () => {
    const results = res.body.data.linkedProjects;
    expect(results).to.have.lengthOf(1);
    expect(results[0].system).to.equal("bkci");
    expect(results[0].success).to.equal(true);
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
