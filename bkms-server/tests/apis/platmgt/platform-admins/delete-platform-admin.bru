meta {
  name: revoke-platform-admin-role
  type: http
  seq: 6
}

delete {
  url: {{serviceURL}}/plat-mgt/admins/{{platAdminCreatedUsername}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 204
}

script:pre-request {
  const seedUser = bru.getVar("platAdminSeedUser");
  const {userInfo} = require("./helpers/tenancy");
  req.setHeader("X-Bk-Authed-User-Info", userInfo(seedUser));
  req.setHeader("X-Bk-Authed-User-Credential", '{"bkTicket":"xxx"}');
}

tests {
  test("should revoke the created platform administrator role", () => {
    expect(res.body).to.equal("");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
