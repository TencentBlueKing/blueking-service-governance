meta {
  name: grant-platform-workspace-temp-admin
  type: http
  seq: 3
}

post {
  url: {{serviceURL}}/plat-mgt/workspaces/{{platMgtWorkspaceID}}/admins
  body: json
  auth: inherit
}

body:json {
  {
    "isTemporary": true
  }
}

assert {
  res.status: eq 204
}

script:pre-request {
  const seedUser = bru.getVar("platAdminSeedUser");
  const {userInfo} = require("./helpers/tenancy");
  req.setHeader("X-Bk-Authed-User-Info", userInfo(seedUser));
  req.setHeader("X-Bk-Authed-User-Credential", '{"bkTicket":"xxx"}');
}

tests {
  test("should grant platform workspace admin as temporary", () => {
    expect(res.body).to.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
