meta {
  name: get-workspace-stats-no-permission
  type: http
  seq: 5
}

get {
  url: {{serviceURL}}/plat-mgt/workspaces/statistics
  body: none
  auth: inherit
}

assert {
  res.status: eq 403
  res.body: isJson
}

script:pre-request {
  const nonManagerUser = bru.getVar("platAdminNonAdminUser");
  const {userInfo} = require("./helpers/tenancy");
  req.setHeader("X-Bk-Authed-User-Info", userInfo(nonManagerUser));
  req.setHeader("X-Bk-Authed-User-Credential", '{"bkTicket":"xxx"}');
}

tests {
  test("should reject non platform administrator user", () => {
    expect(res.body.error).to.be.an("object");
    expect(res.body.error.code).to.equal("NO_PERMISSION");
    expect(res.body.error.message).to.equal("platform administrator permission required");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
