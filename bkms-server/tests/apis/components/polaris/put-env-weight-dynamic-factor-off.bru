meta {
  name: put-env-weight-dynamic-factor-off
  type: http
  seq: 12
}

put {
  url: {{serviceURL}}/apps/{{componentsTrpcAppID}}/deps/polaris-configs/{{testPolarisEnvConfigName}}/envs/test/weight
  body: json
  auth: inherit
}

body:json {
  {
    "weight": 100,
    "dynamicWeight": true
  }
}

assert {
  res.status: eq 200
  res.body: isJson
  res.body.data.envWeights.test: eq 100
}

tests {
  test("should accept the environment switch while the config-level weight factor is off", () => {
    expect(res.body.data.enableWeightFactor).to.equal(false);
    expect(res.body.data.envDynamicWeights).to.deep.equal({ test: true });
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
