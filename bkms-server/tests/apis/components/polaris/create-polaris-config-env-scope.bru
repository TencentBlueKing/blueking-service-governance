meta {
  name: create-polaris-config-env-scope
  type: http
  seq: 3
}

post {
  url: {{serviceURL}}/apps/{{componentsTrpcAppID}}/deps/polaris-configs
  body: json
  auth: inherit
}

body:json {
  {
    "createNewService": false,
    "scopeEnvNames": ["test", "staging"],
    "instanceKey": "testPolarisEnv",
    "polarisName": "test-polaris-env-service",
    "polarisNamespace": "Development",
    "polarisToken": "test-polaris-env-token-xxx",
    "servicePort": 9090,
    "direct": true,
    "keepNotReadyPod": false,
    "enableHealthCheck": true,
    "serviceLabels": {
      "scope": "environment",
      "version": "v1"
    }
  }
}

assert {
  res.status: eq 200
  res.body: isJson
  res.body.data.name: isString
}

script:post-response {
  console.log("Create polaris config (env scope) response:", res.body);
  // Save polaris config name from response for later tests
  if (res.body && res.body.data && res.body.data.name) {
    bru.setVar('testPolarisEnvConfigName', res.body.data.name);
    console.log("Created polaris config name:", res.body.data.name, "(environment scope)");
  }
}

tests {
  test("should create polaris config successfully with environment scope", () => {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an('object');
    expect(res.body.data.name).to.be.a('string');
    expect(res.body.data.name).to.not.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
