meta {
  name: 12-create-helm-chart-build-without-revision
  type: http
  seq: 12
}

post {
  url: {{serviceURL}}/apps/{{helmChartBuildAppID}}/charts/builds
  body: json
  auth: inherit
}

body:json {
  {
    "bumpType": "patch",
    "revisionType": "commit"
  }
}

assert {
  res.status: eq 400
  res.body: isJson
}

tests {
  test("should reject helm chart build without revision", () => {
    expect(res.body.error.message).to.contains("revision or branch is required");
  });
}

settings {
  encodeUrl: true
  timeout: 15000
}
