meta {
  name: 11-create-helm-chart-build-invalid-commit
  type: http
  seq: 11
}

post {
  url: {{serviceURL}}/apps/{{helmChartBuildAppID}}/charts/builds
  body: json
  auth: inherit
}

body:json {
  {
    "bumpType": "patch",
    "revisionType": "commit",
    "revision": "g1b2c3d"
  }
}

assert {
  res.status: eq 400
  res.body: isJson
}

tests {
  test("should reject non hexadecimal commit id before consuming semver", () => {
    expect(res.body.error.message).to.contains("commit id must be 7-40 hexadecimal characters");
  });
}

settings {
  encodeUrl: true
  timeout: 15000
}
