meta {
  name: list-builder-empty
  type: http
  seq: 1
}

get {
  url: {{serviceURL}}/workspaces/{{customBuildImagesWorkspaceID}}/custom-build-images?type=builder&keyword=golang
  body: none
  auth: inherit
}

params:query {
  type: builder
  keyword: golang
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  // 新建工作空间没有任何自定义镜像记录，应返回空数组而非 null 或报错；keyword 为可选参数
  test("should return an empty result list for a fresh workspace", () => {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an('object');
    expect(res.body.data.results).to.be.an('array');
    expect(res.body.data.results).to.have.lengthOf(0);
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
