docs {
  测的是：租户 B 不能删除租户 A 工作空间下的环境变量，返回 404。
  环境变量是否仍然存在由 28 号用例验证。
}

meta {
  name: 27-delete-scoped-env-var-tenant-b
  type: http
  seq: 27
}

delete {
  url: {{serviceURL}}/workspaces/{{tenancyWorkspaceID}}/scoped-env-vars/{{tenancyScopedEnvVarID}}
  body: none
  auth: inherit
}

script:pre-request {
  const {actAs} = require("./helpers/tenancy");
  actAs(req, "B");
}

assert {
  res.status: eq 404
}

settings {
  encodeUrl: true
  timeout: 10000
}
