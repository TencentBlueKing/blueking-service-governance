docs {
  测的是：多租户模式下不带租户头的请求被拒绝（400），而不是落到某个默认租户。
}

meta {
  name: 02-reject-missing-tenant-header
  type: http
  seq: 2
}

get {
  url: {{serviceURL}}/workspaces
  body: none
  auth: inherit
}

script:pre-request {
  // Bruno 3 的 req 没有 deleteHeader；服务端按 Header.Get 读取，空值与未传等价
  req.setHeader("X-Bk-Tenant-Id", "");
}

assert {
  res.status: eq 400
}

settings {
  encodeUrl: true
  timeout: 10000
}
