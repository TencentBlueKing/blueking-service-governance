docs {
  测的是：租户 B 的删除确实生效了，租户 B 中已没有这个组件定义，
  也不会因为租户 A 还有同名记录而在 B 的列表中出现。
}

meta {
  name: 22-list-comp-defs-tenant-b-after-delete
  type: http
  seq: 22
}

get {
  url: {{serviceURL}}/component-defs?keyword={{tenancyCompDefName}}
  body: none
  auth: inherit
}

script:pre-request {
  const {actAs} = require("./helpers/tenancy");
  actAs(req, "B");
}

assert {
  res.status: eq 200
}

tests {
  test("should not list the component def in tenant B any more", () => {
    const defs = res.body.data.filter((d) => d.name === bru.getVar("tenancyCompDefName"));
    expect(defs).to.be.empty;
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
