docs {
  测的是：多租户模式下不带租户头时，租户中间件回退到登录态中的租户，前端功能开关仍可获取。
  不依赖 01 号建的数据，可单独运行。
}

meta {
  name: 38-frontend-features-without-tenant-header
  type: http
  seq: 38
}

get {
  url: {{serviceURL}}/frontend-features
  body: none
  auth: inherit
}

script:pre-request {
  // Bruno 3 的 req 没有 deleteHeader；服务端按 Header.Get 读取，空值与未传等价
  req.setHeader("X-Bk-Tenant-Id", "");
}

assert {
  res.status: eq 200
  res.body.data.enableMultiTenantMode: eq true
}

settings {
  encodeUrl: true
  timeout: 10000
}
