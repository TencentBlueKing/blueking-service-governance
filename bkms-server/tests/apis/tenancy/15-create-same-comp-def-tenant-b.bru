docs {
  测的是：组件定义的 name + version 唯一约束是按租户划分的，
  租户 B 可以创建与租户 A 同名的组件定义，不会因为租户 A 已有同名记录而返回 409。
}

meta {
  name: 15-create-same-comp-def-tenant-b
  type: http
  seq: 15
}

post {
  url: {{serviceURL}}/component-defs
  body: json
  auth: inherit
}

body:json {
  {
    "compDefName": "{{tenancyCompDefName}}",
    "displayName": "Tenancy Component B",
    "description": "created by tenant B",
    "properties": [
      {
        "name": "serviceName",
        "type": "STRING",
        "defaultValue": "my-service",
        "description": "Service name"
      }
    ],
    "patchers": [
      "spec:\n  template:\n    spec:\n      containers:\n        - name: \"{{ .bkmsContainerName }}\"\n          env:\n            - name: SERVICE_NAME\n              value: \"{{ .serviceName }}\""
    ],
    "specs": [
      "apiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: \"{{ .name }}-config\"\ndata:\n  serviceName: \"{{ .serviceName }}\""
    ],
    "scopeType": "global",
    "scopeWorkspaceIDs": []
  }
}

script:pre-request {
  const {actAs} = require("./helpers/tenancy");
  actAs(req, "B");
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 10000
}
