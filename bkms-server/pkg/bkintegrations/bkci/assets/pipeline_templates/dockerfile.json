              "id": "e-ba2d4b9dd5f242b5a343e82d99a397ca",
              "name": "生成 Dockerfile",
              "script": "set -euo pipefail\n\ncd \"$WORKSPACE\"\n\n# 打印关键环境变量，方便流水线出错时排查\necho \"WORKSPACE\" \"$WORKSPACE\"\necho \"BKMS_DOCKERFILE_SOURCE_TYPE\" \"$BKMS_DOCKERFILE_SOURCE_TYPE\"\necho \"BKMS_DOCKERFILE_LANGUAGE\" \"$BKMS_DOCKERFILE_LANGUAGE\"\necho \"BKMS_IMAGE_BUILD_TOOLCHAIN_BASE_URL\" \"$BKMS_IMAGE_BUILD_TOOLCHAIN_BASE_URL\"\necho \"BKMS_DOCKERFILE_BUILDER_IMAGE\" \"$BKMS_DOCKERFILE_BUILDER_IMAGE\"\necho \"BKMS_DOCKERFILE_RUNNER_IMAGE\" \"$BKMS_DOCKERFILE_RUNNER_IMAGE\"\necho \"BKMS_IMAGE_NAME\" \"$BKMS_IMAGE_NAME\"\necho \"BKMS_IMAGE_TAG\" \"$BKMS_IMAGE_TAG\"\necho \"BKMS_DOCKERFILE_PATH\" \"$BKMS_DOCKERFILE_PATH\"\n\n# 非平台生成模式（如仓库自带 Dockerfile）跳过后续步骤，直接由蓝盾插件读取用户提供的 Dockerfile\nif [ \"$BKMS_DOCKERFILE_SOURCE_TYPE\" != \"bkms_generated\" ]; then\n  echo \"skip BKMS Dockerfile Generator because source type is $BKMS_DOCKERFILE_SOURCE_TYPE\"\n  exit 0\nfi\n\n# 平台生成模式必须依赖工具链下载地址，缺失时立即失败，避免后续 curl 报错难定位\nif [ -z \"$BKMS_IMAGE_BUILD_TOOLCHAIN_BASE_URL\" ]; then\n  echo \"BKMS_IMAGE_BUILD_TOOLCHAIN_BASE_URL is empty\"\n  exit 1\nfi\n\n# 准备 Dockerfile 输出目录，generator 二进制下载到 /tmp，避免进入仓库工作区或 Docker build context\ndockerfile_dir=\"$(dirname \"$BKMS_DOCKERFILE_PATH\")\"\nmkdir -p \"$dockerfile_dir\"\n\n# 从工具链仓库下载 bkms-dockerfile-generator 并赋予执行权限\ngenerator_url=\"${BKMS_IMAGE_BUILD_TOOLCHAIN_BASE_URL%/}/bkms-dockerfile-generator\"\ngenerator_path=\"/tmp/bkms-dockerfile-generator\"\n\necho \"download BKMS Dockerfile Generator from $generator_url\"\ncurl -fsSL \"$generator_url\" -o \"$generator_path\"\nchmod +x \"$generator_path\"\n\n# 先输出 generator 版本，便于确认流水线实际使用的二进制版本\necho \"BKMS Dockerfile Generator version\"\n\"$generator_path\" version\n\n# 执行 generator，由其读取环境变量渲染出最终 Dockerfile 到 BKMS_DOCKERFILE_PATH\necho \"execute BKMS Dockerfile Generator\"\n\"$generator_path\"\n\n# 校验生成结果：文件必须存在，否则视为构建失败\nif [ ! -f \"$BKMS_DOCKERFILE_PATH\" ]; then\n  echo \"generated Dockerfile not found at $BKMS_DOCKERFILE_PATH\"\n  exit 1\nfi\n\n# 打印生成的 Dockerfile 内容，便于流水线日志中直观确认渲染结果\necho \"===== generated Dockerfile ($BKMS_DOCKERFILE_PATH) =====\"\ncat \"$BKMS_DOCKERFILE_PATH\"\necho \"===== end of generated Dockerfile =====\"\n",
              "scriptType": "SHELL",
