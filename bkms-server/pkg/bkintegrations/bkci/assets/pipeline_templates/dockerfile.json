              "id": "e-c7fa86b4393945b1a2675dda87b7a648",
              "name": "构建并推送 Docker 镜像",
              "script": "set -euo pipefail\n\ncd \"$WORKSPACE\"\n\n# 必填变量缺失时立即失败，避免推送到错误的仓库或镜像名\nfor var in BKMS_DOCKERFILE_PATH BKMS_DOCKER_BUILD_DIR BKMS_IMAGE_REGISTRY BKMS_IMAGE_NAME BKMS_IMAGE_TAG BKMS_IMAGE_CREDENTIAL; do\n  if [ -z \"${!var:-}\" ]; then\n    echo \"[ERROR] required variable $var is empty\"\n    exit 1\n  fi\ndone\n\n# 打印关键环境变量，方便流水线出错时排查；凭证只打印凭证 ID，不打印账密\necho \"BKMS_DOCKERFILE_PATH\" \"$BKMS_DOCKERFILE_PATH\"\necho \"BKMS_DOCKER_BUILD_DIR\" \"$BKMS_DOCKER_BUILD_DIR\"\necho \"BKMS_IMAGE_REGISTRY\" \"$BKMS_IMAGE_REGISTRY\"\necho \"BKMS_IMAGE_NAME\" \"$BKMS_IMAGE_NAME\"\necho \"BKMS_IMAGE_TAG\" \"$BKMS_IMAGE_TAG\"\necho \"BKMS_IMAGE_CREDENTIAL\" \"$BKMS_IMAGE_CREDENTIAL\"\n\n# 社区版没有构建并推送镜像插件，构建机上必须预装 docker\nif ! command -v docker >/dev/null 2>&1; then\n  echo \"[ERROR] docker command not found on this build machine, please install docker first\"\n  exit 1\nfi\n\n# 账密由蓝盾在执行前替换：Job 环境变量先展开凭证 ID 得到 settings 引用，脚本引用时再兑换成明文\n# 用带引号的 heredoc 承接，避免账密中的 $、引号、反斜杠被 shell 二次解释\n# 不放进命令替换里：低版本 bash 解析命令替换时会被 heredoc 内的反引号干扰\nIFS= read -r registry_username <<'BKMS_CREDENTIAL_EOF'\n${BKMS_IMAGE_REGISTRY_USERNAME}\nBKMS_CREDENTIAL_EOF\nIFS= read -r registry_password <<'BKMS_CREDENTIAL_EOF'\n${BKMS_IMAGE_REGISTRY_PASSWORD}\nBKMS_CREDENTIAL_EOF\n\n# 兑换失败时蓝盾会原样保留占位文本，不能把它当作账密去登录：\n# 凭证不存在或无权限时残留 settings 引用；Job 环境变量未生效（如制约模式）时残留变量引用本身\n# 模板以双方括号作为渲染分隔符，这里不能用 bash 的双方括号条件判断，改用 case\nfor credential_value in \"$registry_username\" \"$registry_password\"; do\n  case \"$credential_value\" in\n    '' | *'{{settings.'* | *'{BKMS_IMAGE_REGISTRY_'*)\n      echo \"[ERROR] failed to resolve username / password from credential $BKMS_IMAGE_CREDENTIAL,\" \\\n        \"please check the credential exists, is of type username+password, and the pipeline uses classic variable syntax\"\n      exit 1\n      ;;\n  esac\ndone\n\n# 构建参数为换行分隔的 KEY=VALUE，空行跳过；变量为空时不追加任何 --build-arg\n# 不能从环境变量读取：蓝盾导出环境变量时会删掉值中的换行和单引号，多个参数会被拼成一个\n# 因此同样用带引号的 heredoc，由蓝盾在执行前把原值整段替换进来\nbuild_args=()\nwhile IFS= read -r build_arg; do\n  case \"$build_arg\" in\n    '')\n      continue\n      ;;\n    *'{BKMS_DOCKER_BUILD_ARGS}'*)\n      echo \"[ERROR] BKMS_DOCKER_BUILD_ARGS is not replaced, please check the pipeline uses classic variable syntax\"\n      exit 1\n      ;;\n  esac\n  build_args+=(--build-arg \"$build_arg\")\ndone <<'BKMS_BUILD_ARGS_EOF'\n${BKMS_DOCKER_BUILD_ARGS}\nBKMS_BUILD_ARGS_EOF\n\n# 服务端约定镜像源地址为 host/namespace，这里仍兜底去掉 scheme 和末尾斜杠，与服务端解析 host 的口径一致\nregistry=\"${BKMS_IMAGE_REGISTRY#http://}\"\nregistry=\"${registry#https://}\"\nregistry=\"${registry%/}\"\nregistry_host=\"${registry%%/*}\"\ntarget_image=\"$registry/$BKMS_IMAGE_NAME:$BKMS_IMAGE_TAG\"\n\n# 使用临时 DOCKER_CONFIG，登录态不落到构建机共享的 ~/.docker/config.json，结束后连同账密一起清理\nDOCKER_CONFIG=\"$(mktemp -d)\"\nexport DOCKER_CONFIG\ncleanup_docker_config() {\n  rm -rf \"$DOCKER_CONFIG\"\n}\ntrap cleanup_docker_config EXIT\n# 构建被取消或超时时会收到 INT / TERM，bash 默认直接退出且不执行 EXIT trap，这里转成 exit 以触发清理\ntrap 'exit 130' INT\ntrap 'exit 143' TERM\n\n# 推送与拉取基础镜像共用同一凭证；通过 stdin 传密码，避免出现在进程参数和日志中\necho \">>> [login] docker login $registry_host\"\nif ! printf '%s' \"$registry_password\" | docker login --username \"$registry_username\" --password-stdin \"$registry_host\"; then\n  echo \"[ERROR] docker login to $registry_host failed\"\n  exit 1\nfi\n# 登录态已写入 DOCKER_CONFIG，后续步骤不再需要明文\nunset registry_username registry_password\n\necho \">>> [build] docker build $target_image\"\n# bash 4.4 以下在 set -u 时展开空数组会报 unbound variable，需用 + 形式兜底\nif ! docker build -f \"$BKMS_DOCKERFILE_PATH\" -t \"$target_image\" ${build_args[@]+\"${build_args[@]}\"} \"$BKMS_DOCKER_BUILD_DIR\"; then\n  echo \"[ERROR] docker build $target_image failed\"\n  exit 1\nfi\n\necho \">>> [push] docker push $target_image\"\nif ! docker push \"$target_image\"; then\n  echo \"[ERROR] docker push $target_image failed\"\n  exit 1\nfi\n\necho \"[DONE] image $target_image has been pushed\"\n",
              "scriptType": "SHELL",
              "stepId": "",
              "taskAtom": "",
              "version": "1.*"
            }
          ],
