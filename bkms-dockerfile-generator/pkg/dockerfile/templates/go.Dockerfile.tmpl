# -------------- builder container --------------
FROM {{ .BuilderImage }} AS builder

{{ range .DockerBuildArgNames -}}
ARG {{ . }}
{{ end -}}

WORKDIR /workspace

RUN mkdir -p /out

# go mod download 需要 git；镜像里已有则跳过，否则按 apk/apt-get/dnf/yum 安装
# dnf 必须在 yum 之前：TencentOS 4 minimal 容器只提供 dnf，不一定有 yum 兼容命令
RUN if command -v git >/dev/null 2>&1; then \
        echo "git already present"; \
    elif command -v apk >/dev/null 2>&1; then \
        apk add --no-cache ca-certificates git; \
    elif command -v apt-get >/dev/null 2>&1; then \
        apt-get update && apt-get install -y --no-install-recommends ca-certificates git && rm -rf /var/lib/apt/lists/*; \
    elif command -v dnf >/dev/null 2>&1; then \
        dnf install -y ca-certificates git && dnf clean all; \
    elif command -v yum >/dev/null 2>&1; then \
        yum install -y ca-certificates git && yum clean all; \
    else \
        echo "git is required for go mod download, but no supported package manager was found" && exit 1; \
    fi

{{ range .DependencyFiles -}}
COPY {{ . }} ./
{{ end -}}
RUN go mod download

COPY . .

{{ range .PreBuildCommands -}}
RUN {{ . }}
{{ end -}}

{{ range .BuildCommands -}}
RUN {{ . }}
{{ end -}}

RUN test -f /out/{{ .AppName }} || (echo "build artifact /out/{{ .AppName }} not found" && exit 1)

# -------------- runner container --------------
FROM {{ .RunnerImage }} AS runner

WORKDIR /app

{{ range .RuntimeEnvCommands -}}
RUN {{ . }}
{{ end -}}

COPY --from=builder /out/{{ .AppName }} /app/{{ .AppName }}

{{ if .StartCommand -}}
ENTRYPOINT ["/bin/sh", "-ec", {{ quoteStartCommand .StartCommand }}]
{{ else -}}
ENTRYPOINT ["/app/{{ .AppName }}"]
{{ end -}}
