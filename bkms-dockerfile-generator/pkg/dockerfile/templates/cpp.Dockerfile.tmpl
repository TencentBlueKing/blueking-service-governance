# FIXME: cpp dockerfile template is still under development, please do not use
# -------------- builder container --------------
FROM {{ .BuilderImage }} AS builder

{{ range .DockerBuildArgNames -}}
ARG {{ . }}
{{ end -}}

WORKDIR /workspace

# BKMS_ARTIFACT_DIR is only visible in the builder stage, build commands should write artifacts into it.
ENV BKMS_ARTIFACT_DIR={{ .ArtifactDir }}
RUN mkdir -p {{ .ArtifactDir }}

COPY . .

{{ range .PreBuildCommands -}}
RUN {{ . }}
{{ end -}}

{{ range .BuildCommands -}}
RUN {{ . }}
{{ end -}}

RUN test -n "$(ls -A {{ .ArtifactDir }} 2>/dev/null)" || (echo "build output directory {{ .ArtifactDir }} is missing or empty" && exit 1)

# -------------- runner container --------------
FROM {{ .RunnerImage }} AS runner

WORKDIR /app

COPY --from=builder {{ .ArtifactDir }}/ /app/

{{ range .ExtraFileCopies -}}
COPY {{ .Source }} {{ .Dest }}
{{ end -}}

{{ range .RuntimeEnvCommands -}}
RUN {{ . }}
{{ end -}}

{{ if .StartCommand -}}
ENTRYPOINT ["/bin/sh", "-ec", {{ quoteStartCommand .StartCommand }}]
{{ else -}}
ENTRYPOINT ["/app/{{ .AppName }}"]
{{ end -}}
