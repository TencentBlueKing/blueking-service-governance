# .env.production — 生产模式生效
#
## 不要写入域名信息, 本地调试在.env.development配置, 发布到环境时联系服务配置中心负责人!!!!!!!!! ##
## 不要写入域名信息, 本地调试在.env.development配置, 发布到环境时联系服务配置中心负责人!!!!!!!!! ##
## 不要写入域名信息, 本地调试在.env.development配置, 发布到环境时联系服务配置中心负责人!!!!!!!!! ##
# 运行时变量使用 __BKMS_RT_xxx__ 占位符，构建时嵌入产物，
# 容器启动时由 docker/docker-entrypoint.sh 注入实际值。
# 参见 DEPLOY.md「运行时环境注入」章节。

## 变量TS类型在 src/vite-env.d.ts 注册 ##

## 添加变量时要写注释, 先检查下之前有没有重复的, 最好用域名作为变量!!!!!!!!! ##
# good eg: BK_XXX = 'https://www.xxx.com' ✅
# bad eg: BK_XXX_A = 'https://www.xxx.com/a'  BK_XXX_B = 'https://www.xxx.com/b' ❌

# =============================================
# 构建时变量（不可运行时覆盖）
# =============================================

BK_NODE_ENV = 'production'

# 静态资源路径（Vite base）；Dockerfile.prod 中 ENV 强制为空以按根路径部署
BK_STATIC_URL = ''

# =============================================
# 运行时变量（占位符，容器启动时替换）
# =============================================

# API 前缀
BK_API_PREFIX = '__BKMS_RT_BK_API_PREFIX__'

# BKMS API 服务地址（CLI apiserver 等）
BK_API_BASE_URL = '__BKMS_RT_BK_API_BASE_URL__'

# 网站 route 前缀
BK_SITE_URL = '__BKMS_RT_BK_SITE_URL__'

# 平台配置地址（项目名称和 title）
BK_SHARED_RES_BASE_JS_URL = '__BKMS_RT_BK_SHARED_RES_BASE_JS_URL__'

# 蓝盾项目
BK_DEVOPS = '__BKMS_RT_BK_DEVOPS__'

# 容器项目
BK_BCS = '__BKMS_RT_BK_BCS__'

# 监控项目
BK_MONITOR = '__BKMS_RT_BK_MONITOR__'

# BCS API 地址
BK_BCS_API_BASE_URL = '__BKMS_RT_BK_BCS_API_BASE_URL__'

# 登录地址（关联: 退出登录）
BK_LOGIN_URL = '__BKMS_RT_BK_LOGIN_URL__'

# 北极星项目
BK_POLARIS_URL = '__BKMS_RT_BK_POLARIS_URL__'

# BSCP 服务配置中心
BK_BSCP_URL = ''

# 文档地址
BK_DOC_URL = '__BKMS_RT_BK_DOC_URL__'

# 权限中心地址
BK_IAM_URL = '__BKMS_RT_BK_IAM_URL__'

# 用于人员选择器 apiBaseUrl
BK_API_URL_TMPL = '__BKMS_RT_BK_API_URL_TMPL__'

# 代码库数据源
BK_REPO_URL = '__BKMS_RT_BK_REPO_URL__'

# Go 代理地址
BK_GOLANG_PROXY_URL = '__BKMS_RT_BK_GOLANG_PROXY_URL__'
