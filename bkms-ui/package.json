{
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "vite build",
    "dev": "vite --mode development",
    "gen:api:v1": "node scripts/gen-api-v1.js",
    "prepare": "cd ../.. && husky apps/ui/.husky",
    "preview": "vite preview",
    "server": "http-server ./dist -p 5000",
